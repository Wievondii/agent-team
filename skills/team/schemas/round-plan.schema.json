{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opencode-agent-team/schemas/round-plan.schema.json",
  "title": "rounds/round-N/plan.md frontmatter (v2)",
  "description": "Planner 输出的轮次计划 YAML frontmatter 强制 schema。",
  "type": "object",
  "required": [
    "schema_version",
    "round",
    "project_type",
    "execution_strategy",
    "modules",
    "integration_lead",
    "acceptance_criteria"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "enum": ["2.0", 2.0] },
    "round": { "type": "integer", "minimum": 1 },
    "project_type": {
      "type": "string",
      "enum": ["interface", "style", "hybrid"]
    },
    "tech_stack": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "framework": { "type": "string" },
        "package_manager": { "type": "string" },
        "test_framework": {
          "type": "string",
          "description": "由 Planner 选择，如 vitest/jest/pytest/cargo-test/go-test"
        }
      }
    },
    "execution_strategy": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "description": "明确指明 PM 应当如何调度 Developer。Planner 必须填写。",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["parallel", "serial", "grouped"],
          "description": "parallel=所有 Developer 同消息并发；serial=逐个串行（仅当模块严格依赖时）；grouped=按 parallel_groups 分批，组内并发组间串行"
        },
        "parallel_groups": {
          "type": "array",
          "description": "仅当 mode=grouped 时使用。每个内部数组是一组并发模块名；组之间串行。",
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        },
        "rationale": {
          "type": "string",
          "description": "为什么选这种模式（一句话即可）"
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "developer", "file_scope"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string" },
          "developer": { "type": "string", "pattern": "^dev-" },
          "file_scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "description": "glob 模式，如 src/auth/**"
            }
          },
          "interfaces_provided": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name"],
              "additionalProperties": false,
              "properties": {
                "name": { "type": "string" },
                "spec_file": { "type": "string" },
                "callers": {
                  "type": "array",
                  "items": { "type": "string" }
                },
                "callee_position": {
                  "type": "string",
                  "description": "调用方应在哪个文件:行 调用，如 src/orders/checkout.ts:45"
                },
                "semantic_constraints": {
                  "type": "array",
                  "items": { "type": "string" },
                  "description": "如：'同名状态不跳过 onEnter'、'初始化必须 force=true 触发回调'"
                }
              }
            }
          },
          "depends_on_specs": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "shared_files": {
      "type": "array",
      "description": "需要多个模块协作修改的共享文件，必须指定 coordinator。",
      "items": {
        "type": "object",
        "required": ["path", "coordinator"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string" },
          "coordinator": { "type": "string", "pattern": "^dev-" },
          "expected_changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["by", "purpose"],
              "properties": {
                "by": { "type": "string", "pattern": "^dev-" },
                "purpose": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "integration_lead": {
      "type": "string",
      "pattern": "^dev-",
      "description": "负责验证所有调用链路的 Developer。"
    },
    "test_contracts": {
      "type": "array",
      "description": "对外接口的测试契约。每个对外接口至少 1 个 happy path + 1 个 error case。",
      "items": {
        "type": "object",
        "required": ["interface", "cases"],
        "additionalProperties": false,
        "properties": {
          "interface": { "type": "string" },
          "cases": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["name"],
              "properties": {
                "name": { "type": "string" },
                "input": {},
                "expected": {},
                "expected_error": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "test_method"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^ac-" },
          "description": { "type": "string" },
          "test_method": {
            "type": "string",
            "enum": ["unit", "integration", "e2e", "manual", "static"]
          }
        }
      }
    },
    "tester_assignments": {
      "type": "array",
      "description": "Planner 指定每个模块由哪个 Tester 负责。PM 按此并行调度 Tester。",
      "items": {
        "type": "object",
        "required": ["tester", "module"],
        "additionalProperties": false,
        "properties": {
          "tester": { "type": "string", "pattern": "^tester-" },
          "module": { "type": "string" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": { "type": "string" },
          "mitigation": { "type": "string" }
        }
      }
    }
  }
}
