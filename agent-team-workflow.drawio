        <!-- ===== KEY LABELS ===== -->
        <mxCell id="note1" value="⚡ 修复循环：同一轮内&#xa;开发者 + 测试员后台常驻&#xa;通过 SendMessage 反复唤醒&#xa;最多循环 3 次" style="text;html=1;fontSize=11;fontColor=#d79b00;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="960" width="190" height="70" as="geometry" />
        </mxCell>

        <mxCell id="note2" value="🔄 轮换机制：每轮结束&#xa;销毁所有子 Agent&#xa;下一轮创建全新实例" style="text;html=1;fontSize=11;fontColor=#9673a6;align=left;" vertex="1" parent="1">
          <mxGeometry x="30" y="1040" width="190" height="60" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
